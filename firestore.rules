rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 60 &&
             (!('userEmail' in data) || data.userEmail is string) &&
             (!('avatarEmoji' in data) || data.avatarEmoji is string) &&
             data.coins is int && data.coins >= 0 &&
             data.totalXp is int && data.totalXp >= 0 &&
             (!('streakDays' in data) || (data.streakDays is int && data.streakDays >= 0)) &&
             (!('totalCoinsEarned' in data) || (data.totalCoinsEarned is int && data.totalCoinsEarned >= 0)) &&
             (!('gamesWon' in data) || (data.gamesWon is int && data.gamesWon >= 0)) &&
             (!('gamesLost' in data) || (data.gamesLost is int && data.gamesLost >= 0));
    }

    function isValidMalaSession(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             (!('mantraId' in data) || (data.mantraId is string && data.mantraId.size() <= 64)) &&
             data.completedMalas is int && data.completedMalas >= 0 &&
             (!('totalChants' in data) || (data.totalChants is int && data.totalChants >= 0)) &&
             data.timestamp is timestamp && data.timestamp <= request.time;
    }

    // Default deny all unlisted documents
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying all users directly

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      // Mala Sessions Subcollection
      match /mala_sessions/{sessionId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidMalaSession(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         isValidMalaSession(incoming());

        allow delete: if isOwner(userId);
      }
    }
  }
}
